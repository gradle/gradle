# Supply-chain hygiene (mirrors the settings used in gradle/gradle docs-site and the migration spec)
# Never run package install/postinstall scripts (sharp >=0.33 does not need them).
ignore-scripts=true
# Always record exact versions on `npm install <pkg>` (no ^ ranges).
save-exact=true
# Only accept package versions published at least 14 days ago (requires npm >= 11.6).
min-release-age=14

---
import ApiDocLinkBase from './ApiDocLinkBase.astro';
import { groovyDslUrl } from './api-doc-url';

interface Props {
  class: string;
  method?: string;
  text?: string;
}

const props = Astro.props;
const href = groovyDslUrl(props.class, props.method);
---

<ApiDocLinkBase {...props} href={href} docClass="groovydoc-link" componentName="GroovyDocLink" />

---
import { Code, Tabs, TabItem } from "@astrojs/starlight/components";
import { getPageScopedSamplePath } from "../../lib/samples";
import { selectSampleContent } from "../../lib/sample-tags";

interface Props {
  sample_name?: string;
  sample?: string;
  path: string;
  lang?: string;
  title?: string;
  tag?: string;
  /** Upstream snippet dir relative to docs/src/ — enables "View source on GitHub". */
  source_dir?: string;
}

const { sample_name, sample, path, lang, title, tag, source_dir } = Astro.props;

const GITHUB_BASE = "https://github.com/gradle/gradle/blob/master/platforms/documentation/docs/src";

function sourceMeta(resolvedPath: string): string | undefined {
  if (!source_dir) return undefined;
  return `sourceUrl="${GITHUB_BASE}/${source_dir}/${resolvedPath}"`;
}

const samplePath = getPageScopedSamplePath(
  Astro.url.pathname,
  sample_name ?? sample ?? ""
);

const sampleFiles = import.meta.glob("/src/samples/**/*", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>;

function inferLanguage(filename: string): string {
  if (filename.endsWith(".gradle.kts") || filename.endsWith(".kt")) return "kotlin";
  if (filename.endsWith(".gradle") || filename.endsWith(".groovy")) return "groovy";
  if (filename.endsWith(".java")) return "java";
  if (filename.endsWith(".xml")) return "xml";
  if (filename.endsWith(".properties")) return "properties";
  if (filename.endsWith(".toml")) return "toml";
  if (filename.endsWith(".yaml") || filename.endsWith(".yml")) return "yaml";
  if (filename.endsWith(".json")) return "json";
  if (filename.endsWith(".sh")) return "bash";
  return "text";
}

interface Variant {
  label: string;
  resolvedPath: string;
  content: string;
}

// The converter tokenizes per-DSL source files ({lang} directory segments,
// {srcExt} for .kt/.groovy) so paired includes arrive as one template.
// Expand it per language; plain paths resolve as a single file.
const VARIANTS = [
  { key: "kotlin", label: "Kotlin", srcExt: "kt" },
  { key: "groovy", label: "Groovy", srcExt: "groovy" },
  { key: "dcl", label: "DCL", srcExt: "dcl" },
] as const;

const isTemplate = path.includes("{lang}") || path.includes("{srcExt}");
const variants: Variant[] = [];

if (isTemplate) {
  for (const v of VARIANTS) {
    const resolved = path.replaceAll("{lang}", v.key).replaceAll("{srcExt}", v.srcExt);
    const filePath = `/src/samples/${samplePath}/${resolved}`;
    const content = sampleFiles[filePath];
    if (content !== undefined && content.trim().length > 0) {
      variants.push({
        label: v.label,
        resolvedPath: resolved,
        content: selectSampleContent(content, tag, filePath),
      });
    }
  }
  if (variants.length === 0) {
    throw new Error(`No variant of sample file '${path}' found in sample '${samplePath}'.`);
  }
} else {
  const filePath = `/src/samples/${samplePath}/${path}`;
  const content = sampleFiles[filePath];
  if (content === undefined) {
    throw new Error(`Sample file '${path}' not found in sample '${samplePath}'.`);
  }
  variants.push({ label: "", resolvedPath: path, content: selectSampleContent(content, tag, filePath) });
}

// Identical content across variants (e.g. the same .java file shipped in both
// DSL variants of a snippet) needs no tabs.
const allIdentical = variants.every((v) => v.content === variants[0].content);
const single = variants.length === 1 || allIdentical ? variants[0] : null;
---

{
  single ? (
    <Code
      code={single.content}
      lang={lang ?? inferLanguage(single.resolvedPath)}
      title={title ?? single.resolvedPath}
      meta={sourceMeta(single.resolvedPath)}
    />
  ) : (
    <Tabs syncKey="script-language">
      {variants.map((v) => (
        <TabItem label={v.label}>
          <Code
            code={v.content}
            lang={lang ?? inferLanguage(v.resolvedPath)}
            title={title ?? v.resolvedPath}
            meta={sourceMeta(v.resolvedPath)}
          />
        </TabItem>
      ))}
    </Tabs>
  )
}

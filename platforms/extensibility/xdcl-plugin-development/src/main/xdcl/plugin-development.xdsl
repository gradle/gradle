package org.gradle.demos.plugindev.dsl

import org.gradle.demos.common.dsl

// The declarative face of authoring an XDCL Gradle plugin. The template itself is deliberately
// minimal: the plugin's identity, schemas, and defaults are single-sourced from the project's own
// `src/main/xdcl/` files (the `<plugin-id>.xdcl` plugin block — role 1), so the project type only has
// to mark the project as an XDCL plugin build and carry the dependency/repository surface every
// plugin project needs (e.g. to depend on a published ecosystem schema library).

/// Top-level project type for authoring an XDCL Gradle plugin: schemas and the plugin declaration
/// live under `src/main/xdcl/`; the reaction wires the real Gradle plugin-development machinery
/// (java-library, java-gradle-plugin, and the bundled xdcl codegen plugin) onto the project.
template XdclGradlePlugin
 with HasRepositories & HasDependencies {
  xdclGradlePlugin {
  }
}

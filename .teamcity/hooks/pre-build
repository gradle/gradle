# Pre-build hook entry point (file name required by the teamcity-hooks-plugin).
# Clean first, so leftovers from earlier builds on a shared agent are removed even if the
# restore fails. The restore script removes the ~/.m2/.develocity it writes itself.

set -euo pipefail
SCRIPTS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/scripts"

"${SCRIPTS}/clean-maven-and-android-home.sh"
"${SCRIPTS}/restore-int-test-gradle-home.sh"
